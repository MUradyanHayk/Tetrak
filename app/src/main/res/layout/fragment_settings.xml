<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:clipToPadding="false"
    tools:context=".screens.settings.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-12dp"
            app:navigationContentDescription="@string/back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/settings"
            app:titleTextColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_subtitle"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theme_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/theme_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/theme_system"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/theme_system"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/theme_light"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/theme_light"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/theme_dark"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/theme_dark"
                        android:textColor="?attr/colorOnSurface" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/language_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/language"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/language_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/language_system"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_system"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_english"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_english"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_armenian"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_armenian"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_russian"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_russian"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_arabic"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_arabic"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_persian"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_persian"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_spanish"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_spanish"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_french"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_french"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_german"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_german"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_portuguese"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_portuguese"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_hindi"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_hindi"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_chinese"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_chinese"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_japanese"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_japanese"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_korean"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_korean"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_turkish"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_turkish"
                        android:textColor="?attr/colorOnSurface" />

                    <RadioButton
                        android:id="@+id/language_ukrainian"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/language_ukrainian"
                        android:textColor="?attr/colorOnSurface" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/premium_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="28dp"
            app:cardElevation="3dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_empty_icon"
                        android:contentDescription="@string/premium"
                        android:padding="7dp"
                        android:src="@drawable/ic_premium" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/premium"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/premium_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="Active" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/premium_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/premium_info"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/premium_upgrade_btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/premium_upgrade"
                        app:icon="@drawable/ic_premium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/premium_restore_btn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/premium_restore" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/premium_debug_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/premium_dev_unlock"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ads_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ads"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/ads_info"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/deleted_notes_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/deleted_notes"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/deleted_notes_retention"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    tools:text="Deleted notes are kept for 30 days." />

                <TextView
                    android:id="@+id/deleted_notes_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="2 deleted notes" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deleted_notes_open_btn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/view_deleted_notes"
                    app:icon="@drawable/ic_history" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
